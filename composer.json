{
    "name": "noiz/ispconfig-connect-whmcs",
    "description": "ISPConfig Connect for WHMCS - dev tooling only; the shipped module is dependency-free plain PHP",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "WHMCS\\Module\\Server\\Ispconfigconnect\\": "modules/servers/ispconfigconnect/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ispconfigconnect\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    }
}
